# Generate a secret key using the command in README.md.
DJANGO_SECRET_KEY=

# Local development settings. Do not enable DEBUG in production.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional settings; these are also the defaults in config/settings.py.
DJANGO_TIME_ZONE=Europe/Kirov
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional: set a private password only when creating demo data.
PULSEPLAN_DEMO_PASSWORD=
