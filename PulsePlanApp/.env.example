# Generate a secret key using the command in README.md.
DJANGO_SECRET_KEY=

# Local development settings. Do not enable DEBUG in production.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production HTTPS behind Nginx:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=pulseplan.treidendev.ru
# DJANGO_CSRF_TRUSTED_ORIGINS=https://pulseplan.treidendev.ru

# Optional settings; these are also the defaults in config/settings.py.
DJANGO_TIME_ZONE=Europe/Kirov
# Local password resets are printed to the server console. Remove this line in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production password-reset delivery via SMTP (example: STARTTLS on port 587).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_USE_SSL=False
# DJANGO_DEFAULT_FROM_EMAIL=PulsePlan <noreply@example.com>

# Optional: set a private password only when creating demo data.
PULSEPLAN_DEMO_PASSWORD=
